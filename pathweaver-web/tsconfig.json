{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "jsx": "preserve", "lib": ["ES2022", "DOM", "DOM.Iterable"], "skipLibCheck": true, "noEmit": true,
    "types": ["vite/client"], "isolatedModules": true, "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "e2e/**/*.ts"]
}
